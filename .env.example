# Never use NEXT_PUBLIC_ for credentials. Demo is enabled until explicitly disabled.
DEMO_MODE=true
# Tesla OAuth user access token, not an application client secret.
TESLA_ACCESS_TOKEN=
TESLA_VIN=
TESLA_REGION=eu
TESLA_CLIENT_ID=
TESLA_CLIENT_SECRET=
TESLA_APP_DOMAIN=
TESLA_REDIRECT_URI=http://localhost:3000/api/tesla/callback
# OAuth flow saves rotating tokens here automatically in .env.local.
TESLA_REFRESH_TOKEN=
TESLA_TOKEN_EXPIRES_AT=
TESLA_REGISTERED=false
# Site protection is always enabled. Secret and approved account subject are saved
# automatically on first successful site sign-in. Never use NEXT_PUBLIC_ here.
SITE_SESSION_SECRET=
TESLA_AUTH_SUBJECT=
SITE_ALLOWED_ORIGINS=http://192.168.0.102:3000,http://127.0.0.1:3000
# Machine credential for Prometheus; does not grant dashboard access.
METRICS_TOKEN=
# Separate server-to-server read credential for workstation development.
DASHBOARD_READ_TOKEN=
# Workstation only: NAS protected read endpoint and its credential.
DASHBOARD_READ_PROXY=
DASHBOARD_READ_PROXY_TOKEN=
# NAS: separate credentials for the journey worker and OAuth intake.
JOURNEY_RECORDER_TOKEN=
JOURNEY_AUTH_TOKEN=
# Workstation only: NAS OAuth intake credential (never a Tesla refresh token).
JOURNEY_AUTH_RELAY_TOKEN=
# Base64-encoded PEM. Never expose this through client code or public files.
TESLA_PRIVATE_KEY_BASE64=
OCTOPUS_API_KEY=
OCTOPUS_ACCOUNT_NUMBER=
# Optional: select a specific Octopus smart device when the account has several.
OCTOPUS_DEVICE_ID=
OCTOPUS_MPAN=
OCTOPUS_METER_SERIAL=
OCTOPUS_PRODUCT_CODE=
OCTOPUS_TARIFF_CODE=
